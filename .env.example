# =====================================================================
# Bibliotecas Conectadas - API | Configuração de ambiente
# =====================================================================
# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ser versionado (já está no .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# BANCO DE DADOS
# ---------------------------------------------------------------------
# String de conexão do PostgreSQL (Neon).
# Se ficar vazia, a aplicação usa SQLite local automaticamente,
# o que é suficiente para rodar o projeto pela primeira vez.
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

DATABASE_SSL_REQUIRE=True

# ---------------------------------------------------------------------
# SEGURANÇA E EXECUÇÃO
# ---------------------------------------------------------------------
# Qualquer texto serve em desenvolvimento. Em produção, gere uma chave
# aleatória longa e nunca a versione.
SECRET_KEY=chave-local-de-desenvolvimento

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# CONSULTA DE ISBN (opcional)
# ---------------------------------------------------------------------
# O preenchimento automático de livros por ISBN funciona sem chave,
# usando a Open Library. As demais variáveis são opcionais.
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_TIMEOUT_SECONDS=10
OPENLIBRARY_USER_AGENT=BibliotecasConectadas/1.0
OPENLIBRARY_CONTACT_EMAIL=

BRASILAPI_BASE_URL=https://brasilapi.com.br/api
BRASILAPI_TIMEOUT_SECONDS=10

GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_TIMEOUT_SECONDS=10
GOOGLE_BOOKS_API_KEY=

ISBN_LOOKUP_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------
# TRADUÇÃO DE METADADOS (opcional)
# ---------------------------------------------------------------------
GOOGLE_TRANSLATE_ENABLED=False
GOOGLE_TRANSLATE_API_KEY=
MYMEMORY_BASE_URL=https://api.mymemory.translated.net
MYMEMORY_CONTACT_EMAIL=
TRANSLATION_SOURCE_LANG=en
TRANSLATION_TARGET_LANG=pt-BR
TRANSLATION_FIELDS=genero,tipo_obra

# ---------------------------------------------------------------------
# CONTA TÉCNICA DO POWER BI (herdado do PI IV)
# ---------------------------------------------------------------------
# Usado apenas pelo endpoint /gestor/analytics/powerbi/.
# Não é necessário para o desenvolvimento do módulo do PI VI.
# A senha nunca deve ser versionada.
BIBLIO_POWERBI_USERNAME=
BIBLIO_POWERBI_PASSWORD=
BIBLIO_POWERBI_EMAIL=
